# Cage with the TabulaRasa GUI on tty1. Screen and input access via seatd (no logind/PAM session needed).
[Unit]
Description=TabulaRasa (kiosk)
After=systemd-user-sessions.service seatd.service getty@tty1.service
Wants=seatd.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/tabularasa-kiosk
Restart=always
RestartSec=2
User=root
# Without a logind session nobody creates the Wayland runtime directory
RuntimeDirectory=tabularasa
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/tabularasa
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
