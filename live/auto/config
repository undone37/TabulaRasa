#!/bin/sh
# Wird von 'lb config' aufgerufen. Debian 13, nur das Nötigste, Hybrid-ISO (BIOS + UEFI + Secure Boot).
set -e
lb config noauto \
	--distribution trixie \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--debian-installer none \
	--apt-recommends false \
	--memtest none \
	--iso-volume TABULARASA \
	--image-name tabularasa \
	--bootappend-live "boot=live components quiet timezone=Europe/Berlin utc=no" \
	"${@}"
